# Copy to .env and fill in. Never commit .env.

# "production" makes the backend refuse to start with unsafe settings (dev JWT secret,
# no Groq key). The Docker image sets it for you.
APP_ENV=local

# Local Docker Postgres. A hosted one (e.g. Neon) can be pasted as-is:
# postgresql://user:pw@host/db?sslmode=require is converted automatically.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# Websites allowed to call the API from a browser (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- Step 2 (LLM + tracing), all free tiers ---
# https://console.groq.com/keys
GROQ_API_KEY=
# https://smith.langchain.com  (free developer plan)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Agent-based workspace: traces are addressed by agent id + environment
# (local | development | staging | production). Don't also set LANGSMITH_PROJECT.
LANGSMITH_AGENT_ID=rag
LANGSMITH_AGENT_ENVIRONMENT=local
